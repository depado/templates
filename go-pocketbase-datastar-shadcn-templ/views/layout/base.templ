package layout

import (
	"{{.gitserver}}/{{.owner}}/{{.name}}/components"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/toast"
)

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#09090b"/>
			<script>
				if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			</script>
			<script type="module" src="/assets/js/datastar.js"></script>
			<style>
				/* The Geist font family (nova preset); shadcn-templ's CLI does not
				   install fonts, so they are downloaded by make bootstrap and
				   served from our own assets. */
				@font-face {
					font-family: "Geist";
					src: url("/assets/fonts/geist/geist-variable.woff2") format("woff2-variations");
					font-weight: 100 900;
					font-display: swap;
				}
				@font-face {
					font-family: "Geist Mono";
					src: url("/assets/fonts/geist/geist-mono-variable.woff2") format("woff2-variations");
					font-weight: 100 900;
					font-display: swap;
				}
				:root {
					--font-sans: "Geist", ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
					--font-mono: "Geist Mono", ui-monospace, SFMono-Regular, "SF Mono", Consolas, "Liberation Mono", Menlo, monospace;
				}
			</style>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			@components.Scripts()
			<title id="page-title">{ title } - datastar-pb-shadcn-templui</title>
		</head>
		<body
			data-on:popstate__window="@get(location.pathname)"
			class="min-h-screen bg-background font-sans antialiased"
		>
			{ children... }
			@toast.Toaster()
			<div
				data-on:datastar-fetch="evt.detail.type === 'error' && window.tui?.toast?.add({title: 'Request failed', description: 'Something went wrong, please try again.', type: 'error'})"
				hidden
			></div>
			<script>
				// The sidebar menu is rendered once (full page); on fragment
				// navigation the active state is synced client-side from the
				// current path. Matches [data-sidebar="menu-button"] hrefs.
				function syncNavActive() {
					var path = window.location.pathname;
					document.querySelectorAll('[data-sidebar="menu-button"]').forEach(function (el) {
						if (el.getAttribute('href') === path) {
							el.setAttribute('data-active', '');
						} else {
							el.removeAttribute('data-active');
						}
					});
				}
				document.addEventListener('datastar-fetch', function (e) {
					if (e.detail && e.detail.type === 'finished') syncNavActive();
				});
				window.addEventListener('popstate', syncNavActive);
				// ⌘K / Ctrl+K opens the command palette (only on pages that
				// render it).
				document.addEventListener('keydown', function (e) {
					if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
						e.preventDefault();
						var dialog = document.getElementById('command-palette');
						if (dialog) window.tui?.dialog?.toggle('command-palette');
					}
				});
				function toggleTheme() {
					if (document.documentElement.classList.contains('dark')) {
						document.documentElement.classList.remove('dark');
						localStorage.theme = 'light';
					} else {
						document.documentElement.classList.add('dark');
						localStorage.theme = 'dark';
					}
				}
			</script>
		</body>
	</html>
}
