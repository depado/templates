package layout

import (
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/avatar"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/button"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/command"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/dialog"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/dropdownmenu"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/icon"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/sidebar"

	"{{.gitserver}}/{{.owner}}/{{.name}}/models"
)

type AppLayoutProps struct {
	Title       string
	CurrentPath string
	User        *models.User
	// SidebarCollapsed is the initial sidebar state, restored from the
	// client-side "sidebar_state" cookie on full page loads.
	SidebarCollapsed bool
}

templ AppLayout(props AppLayoutProps) {
	@Base(props.Title) {
		@sidebar.Provider(sidebar.ProviderProps{DisableDefaultOpen: props.SidebarCollapsed}) {
			@sidebar.Sidebar(sidebar.Props{
				Variant:     sidebar.VariantInset,
				Collapsible: sidebar.CollapsibleIcon,
			}) {
				@sidebar.Header() {
					<a href="/" class="flex items-center gap-2 px-2">
						@icon.Rocket(icon.Props{Class: "size-5"})
						<span class="font-semibold text-lg truncate group-data-[collapsible=icon]:hidden">Datastar PB</span>
					</a>
				}
				@sidebar.Content() {
					@Nav(props.CurrentPath, props.User)
				}
				@sidebar.Footer() {
					@UserMenu(props.User)
				}
			}
			@sidebar.Inset() {
				<header class="flex h-14 items-center gap-2 border-b px-4">
					@sidebar.Trigger()
					<h1 class="text-lg font-semibold flex-1"><span id="page-heading">{ props.Title }</span></h1>
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Class:   "w-40 justify-start text-muted-foreground",
						Attributes: dialog.TriggerFor("command-palette"),
					}) {
						@icon.Search(icon.Props{Class: "size-4"})
						<span>Search...</span>
						<kbd class="ml-auto pointer-events-none inline-flex h-5 items-center gap-1 rounded bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground">⌘K</kbd>
					}
					<span data-indicator="navloading" class="size-4 animate-spin text-muted-foreground" data-show="$navloading" style="display:none">@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})</span>
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Attributes: templ.Attributes{
							"onclick":    "toggleTheme()",
							"aria-label": "Toggle theme",
						},
					}) {
						<span class="hidden dark:inline">@icon.Sun(icon.Props{Class: "size-4"})</span>
						<span class="inline dark:hidden">@icon.Moon(icon.Props{Class: "size-4"})</span>
					}
				</header>
				<main id="main-content" class="flex-1 p-4 md:p-6">
					{ children... }
				</main>
			}
		}
		@CommandPalette()
	}
}

// CommandPalette is the ⌘K command menu: navigate, toggle the theme or sign
// out. Items act on the bubbling "command-select" event (fires on click and
// Enter), so the actions work with both keyboard and mouse.
templ CommandPalette() {
	@command.Dialog(command.DialogProps{ID: "command-palette"}) {
		@command.Command() {
			@command.Input(command.InputProps{Placeholder: "Type a command or search..."})
			@command.List() {
				@command.Empty() {
					No results found.
				}
				@command.Group(command.GroupProps{Heading: "Navigation"}) {
					@command.Item(command.ItemProps{
						Value: "Dashboard home",
						Attributes: templ.Attributes{
							"data-on:command-select": "window.tui?.dialog?.close('command-palette'); @get('/'); history.pushState({}, '', '/')",
						},
					}) {
						@icon.House(icon.Props{})
						<span>Dashboard</span>
					}
					@command.Item(command.ItemProps{
						Value: "Settings preferences",
						Attributes: templ.Attributes{
							"data-on:command-select": "window.tui?.dialog?.close('command-palette'); @get('/settings'); history.pushState({}, '', '/settings')",
						},
					}) {
						@icon.Settings(icon.Props{})
						<span>Settings</span>
					}
				}
				@command.Separator()
				@command.Group(command.GroupProps{Heading: "Actions"}) {
					@command.Item(command.ItemProps{
						Value: "Toggle theme toggle dark mode",
						Attributes: templ.Attributes{
							"data-on:command-select": "window.tui?.dialog?.close('command-palette'); toggleTheme()",
						},
					}) {
						@icon.SunMoon(icon.Props{})
						<span>Toggle theme</span>
					}
					@command.Item(command.ItemProps{
						Value: "Sign out logout",
						Attributes: templ.Attributes{
							"data-on:command-select": "window.tui?.dialog?.close('command-palette'); @post('/logout')",
						},
					}) {
						@icon.LogOut(icon.Props{})
						<span>Sign out</span>
					}
				}
			}
		}
	}
}

// Nav renders the sidebar menu with the active state set from the current
// path on full page loads. On fragment navigation the active state is synced
// client-side by base.templ's syncNavActive().
templ Nav(currentPath string, user *models.User) {
	<nav id="main-nav" class="flex min-h-0 flex-1 flex-col">
		@sidebar.Group() {
			@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:     "/",
						IsActive: currentPath == "/",
						Tooltip:  "Dashboard",
						Attributes: templ.Attributes{
							"data-on:click__prevent": `@get('/'); history.pushState({}, '', '/')`,
							"data-indicator":         "navloading",
						},
					}) {
						@icon.House(icon.Props{})
						<span>Dashboard</span>
					}
				}
			}
		}
		</nav>
	}

templ UserMenu(user *models.User) {
	@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
		@sidebar.MenuItem() {
			if user != nil {
				@dropdownmenu.DropdownMenu() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Size:       sidebar.MenuButtonSizeLg,
						Attributes: dropdownmenu.Trigger(ctx),
					}) {
						@avatar.Avatar(avatar.Props{Class: "size-8"}) {
							if user.Avatar() != "" {
								@avatar.Image(avatar.ImageProps{
									Src: "/api/files/users/" + user.Id + "/" + user.Avatar(),
									Alt: user.Name(),
								})
							}
							@avatar.Fallback() {
								{ user.Initials() }
							}
						}
						<div class="flex flex-col flex-1 text-left">
							<span class="text-sm font-medium">{ user.Name() }</span>
							<span class="text-xs text-muted-foreground">{ user.Email() }</span>
						</div>
						@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
					}
					@dropdownmenu.Content(dropdownmenu.ContentProps{
						Side:  dropdownmenu.SideTop,
						Align: dropdownmenu.AlignStart,
						Class: "w-56",
					}) {						@dropdownmenu.Item(dropdownmenu.ItemProps{
							Href: "/settings",
							Attributes: templ.Attributes{
								"data-on:click__prevent": `@get('/settings'); history.pushState({}, '', '/settings')`,
							},
						}) {
							<span class="flex items-center">
								@icon.Settings(icon.Props{Class: "size-4 mr-2"})
								Settings
							</span>
						}
						@dropdownmenu.Separator()
						@dropdownmenu.Item(dropdownmenu.ItemProps{
							Attributes: templ.Attributes{
								"data-on:click__prevent": `@post('/logout')`,
							},
						}) {
							<span class="flex items-center">
								@icon.LogOut(icon.Props{Class: "size-4 mr-2"})
								Sign out
							</span>
						}
					}
				}
			}
		}
	}
}
