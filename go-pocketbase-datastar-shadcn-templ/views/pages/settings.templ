package pages

import (
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/avatar"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/button"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/card"
	"{{.gitserver}}/{{.owner}}/{{.name}}/components/input"

	"{{.gitserver}}/{{.owner}}/{{.name}}/models"
	"{{.gitserver}}/{{.owner}}/{{.name}}/views/layout"
)

type SettingsData struct {
	User *models.User
}

// SettingsFragment is the Datastar response for fragment navigation.
templ SettingsFragment(props layout.AppLayoutProps, data SettingsData) {
	<title id="page-title">Settings - {{.name}}</title>
	<span id="page-heading">Settings</span>
	<main id="main-content" class="flex-1 p-4 md:p-6">
		@SettingsContent(data)
	</main>
}

templ SettingsPage(props layout.AppLayoutProps, data SettingsData) {
	@layout.AppLayout(props) {
		@SettingsContent(data)
	}
}

templ SettingsContent(data SettingsData) {
	<div class="grid gap-4 max-w-2xl">
		@card.Card() {
			@card.Header() {
				@card.Title() { Profile }
			}
			@card.Content() {
				<div class="flex items-center gap-4">
					@avatar.Avatar(avatar.Props{Class: "size-16"}) {
						if data.User.Avatar() != "" {
							@avatar.Image(avatar.ImageProps{
								Src: "/api/files/users/" + data.User.Id + "/" + data.User.Avatar(),
								Alt: data.User.Name(),
							})
						}
						@avatar.Fallback() {
							<span class="text-xl">{ data.User.Initials() }</span>
						}
					}
					<div>
						<p class="font-medium">{ data.User.Name() }</p>
						<p class="text-sm text-muted-foreground">{ data.User.Email() }</p>
					</div>
				</div>
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() { Change Password }
			}
			@card.Content() {
				@PasswordForm("")
			}
		}
	</div>
}

// PasswordForm is re-patched in place after a successful change: the success
// message is rendered inline and the fields come back empty. On errors only
// #pw-message is patched so the typed values survive the morph.
templ PasswordForm(success string) {
	<form id="password-form" data-on:submit="@post('/settings/password', {contentType: 'form'})" class="space-y-4">
		if success != "" {
			<p id="pw-message" class="text-sm text-primary" role="status">{ success }</p>
		} else {
			<p id="pw-message" class="empty:hidden"></p>
		}
		@input.Input(input.Props{
			Type:        "password",
			Name:        "current_password",
			Placeholder: "Current password",
			Required:    true,
		})
		@input.Input(input.Props{
			Type:        "password",
			Name:        "new_password",
			Placeholder: "New password (min 8 characters)",
			Required:    true,
		})
		@input.Input(input.Props{
			Type:        "password",
			Name:        "confirm_password",
			Placeholder: "Confirm new password",
			Required:    true,
		})
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			Update Password
		}
	</form>
}

type MessageKind string

const (
	MessageError   MessageKind = "error"
	MessageSuccess MessageKind = "success"
)

templ PasswordMessage(kind MessageKind, msg string) {
	if kind == MessageError {
		<p id="pw-message" class="text-sm text-destructive" role="alert">{ msg }</p>
	} else {
		<p id="pw-message" class="text-sm text-primary" role="status">{ msg }</p>
	}
}
